{
  "$schema": "https://schemas.microsoft.com/entra/cyot/package-manifest/v1",
  "descriptor": {
    "name": "telesign-telco-cyot",
    "displayName": "Telesign Verify \u2014 Multichannel OTP & Identity Verification for Microsoft Entra",
    "description": "Keep SMS & voice MFA in Microsoft Entra \u2014 plus multichannel OTP and fraud signals from Telesign.",
    "version": "0.1.0",
    "category": "Telephony",
    "previewState": "PrivatePreview"
  },
  "publisher": {
    "publisherId": "telesigncorporation1779799505747",
    "tenantId": "d818b557-ea1c-4070-a3f1-928330b7a30c",
    "partnerCenterOfferId": "telesign-verify-cyot-azure",
    "mpnId": "4910537"
  },
  "metadata": {
    "endpoints": {
      "sms": {
        "url": "https://rest-ww.telesign.com/integration/microsoft-cyot/sms",
        "eudbUrl": "",
        "appId": "00000000-0000-0000-0000-000000000000",
        "timeoutMilliseconds": 1500,
        "retryIntervalSeconds": 30
      },
      "voice": {
        "url": "https://rest-ww.telesign.com/integration/microsoft-cyot/voice",
        "eudbUrl": "",
        "appId": "00000000-0000-0000-0000-000000000000",
        "timeoutMilliseconds": 1500,
        "retryIntervalSeconds": 30
      },
      "certification": {
        "url": "https://rest-ww.telesign.com/integration/microsoft-cyot/ping",
        "eudbUrl": "",
        "appId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "supportedChannels": ["sms", "voice"],
    "supportedSubchannels": {
      "sms": ["sms"],
      "voice": ["mobile", "landline", "VoIP", "phone numbers with extensions"]
    },
    "supportedRegions": ["US"],
    "certificationStandards": ["ISO 27001", "ISO 27002", "HIPAA", "SOC 2 Type II"],
    "geoRouting": {
      "supportedCountryCodes": ["+1"]
    }
  },
  "security": {
    "fraudProtection": {
      "irsfProtection": false,
      "pumpingDetection": false,
      "fraudDashboardUrl": ""
    }
  },
  "rateLimiting": {
    "perUserPerSecond": 1,
    "perUserCooldownSeconds": 30,
    "perTenantPerMinute": 1000,
    "maxRetriesPerOtp": 3,
    "otpTtlSeconds": 300
  },
  "senderConfiguration": {
    "requiresSenderIdPurchase": true,
    "requiresCallerIdPurchase": false,
    "requiresBusinessLicense": false,
    "providerAdminPortalUrl": "https://my.telesign.com/sender-id-registration",
    "estimatedApprovalDays": 5
  },
  "support": {
    "technicalContactEmail": "support@telesign.com",
    "statusPageUrl": "https://status.telesign.com",
    "documentationUrl": "https://support.telesign.com/url-tbd"
  },
  "deployment": {
    "enabled": true,
    "testConfiguration": true,
    "providerName": "telesign",
    "providerTenantId": "00000000-0000-0000-0000-000000000000",
    "providerScope": "api://00000000-0000-0000-0000-000000000000/.default",
    "providerEndpoint": "https://telesign.example.invalid",
    "placeholderFields": [
      "providerTenantId",
      "providerScope",
      "providerEndpoint",
      "metadata.endpoints.sms.appId",
      "metadata.endpoints.voice.appId",
      "metadata.endpoints.certification.appId"
    ],
    "note": "DUMMY test values are intentionally written to Function App settings. The supplied channel URLs and publisher tenant are preserved, but do not establish a working API-key base URL or API token audience."
  }
}
