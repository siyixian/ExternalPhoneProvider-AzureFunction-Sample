{
  "$schema": "https://schemas.microsoft.com/entra/cyot/package-manifest/v1",
  "descriptor": {
    "name": "telesign-telco-cyot",
    "displayName": "Telesign Verify — Multichannel OTP & Identity Verification for Microsoft Entra",
    "description": "Keep SMS & voice MFA in Microsoft Entra — plus multichannel OTP and fraud signals from Telesign.",
    "version": "0.1.0",
    "category": "Telephony",
    "previewState": "PrivatePreview"
  },
  "publisher": {
    "publisherId": "telesigncorporation1779799505747",
    "tenantId": "d818b557-ea1c-4070-a3f1-928330b7a30c",
    "partnerCenterOfferId": "telesign-verify-cyot-azure",
    "mpnId": "4910537"
  },
  "metadata": {
    "supportedChannels": ["sms", "voice"],
    "supportedSubchannels": {
      "sms": ["sms"],
      "voice": ["mobile", "landline", "VoIP", "phone numbers with extensions"]
    },
    "supportedRegions": ["global", "eu"],
    "certificationStandards": ["ISO 27001", "ISO 27002", "HIPAA", "SOC 2 Type II"],
    "geoRouting": {
      "supportedCountryCodes": ["+1"]
    }
  },
  "security": {
    "fraudProtection": {
      "irsfProtection": false,
      "pumpingDetection": false,
      "fraudDashboardUrl": ""
    }
  },
  "rateLimiting": {
    "perUserPerSecond": 1,
    "perUserCooldownSeconds": 30,
    "perTenantPerMinute": 1000,
    "maxRetriesPerOtp": 3,
    "otpTtlSeconds": 300
  },
  "senderConfiguration": {
    "requiresSenderIdPurchase": true,
    "requiresCallerIdPurchase": false,
    "requiresBusinessLicense": false,
    "providerAdminPortalUrl": "https://my.telesign.com/sender-id-registration",
    "estimatedApprovalDays": 5
  },
  "support": {
    "technicalContactEmail": "support@telesign.com",
    "statusPageUrl": "https://status.telesign.com",
    "documentationUrl": "https://support.telesign.com/url-tbd"
  },
  "deployment": {
    "enabled": true,
    "testConfiguration": true,
    "providerName": "telesign",
    "authentication": {
      "mode": "apiKey",
      "keyVaultSecretName": "telesign-api-key",
      "identityKeyVaultSecretName": "telesign-customer-id"
    },
    "routes": {
      "sms": {
        "global": {
          "endpoint": "https://rest-ww.telesign.com/integration/microsoft-cyot/sms",
          "appId": "00000000-0000-0000-0000-000000000000",
          "timeoutMilliseconds": 1500,
          "retryIntervalSeconds": 30
        },
        "eu": {
          "endpoint": "https://telesign-eu.example.invalid/integration/microsoft-cyot/sms",
          "appId": "00000000-0000-0000-0000-000000000000",
          "timeoutMilliseconds": 1500,
          "retryIntervalSeconds": 30
        }
      },
      "voice": {
        "global": {
          "endpoint": "https://rest-ww.telesign.com/integration/microsoft-cyot/voice",
          "appId": "00000000-0000-0000-0000-000000000000",
          "timeoutMilliseconds": 1500,
          "retryIntervalSeconds": 30
        },
        "eu": {
          "endpoint": "https://telesign-eu.example.invalid/integration/microsoft-cyot/voice",
          "appId": "00000000-0000-0000-0000-000000000000",
          "timeoutMilliseconds": 1500,
          "retryIntervalSeconds": 30
        }
      }
    },
    "note": "The supplied global SMS and voice URLs are preserved. EU URLs and application IDs are explicit test values until Telesign provides them."
  }
}
